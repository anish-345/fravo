<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- Top Header: Fravo Logo + App Name + Status -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true">

            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="Fravo Logo" />

            <TextView
                android:id="@+id/widget_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Fravo"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="ACTIVE"
            android:textColor="@color/widget_status_active"
            android:textSize="10sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Main Content Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="2">

        <!-- Steps Card (Dashboard Ratio) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/widget_card_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👟 STEPS"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fravo_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0"
                android:textColor="@color/widget_steps_accent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fravo_step_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Goal: 10,000"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- FREE USER CONTAINER: Circular Progress Chart with App Logo in Center -->
        <RelativeLayout
            android:id="@+id/widget_free_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:padding="6dp"
            android:background="@drawable/widget_card_background"
            android:visibility="visible">

            <!-- Circular Progress Bar -->
            <ProgressBar
                android:id="@+id/widget_circular_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="62dp"
                android:layout_height="62dp"
                android:layout_centerHorizontal="true"
                android:indeterminate="false"
                android:max="100"
                android:progress="75"
                android:progressDrawable="@drawable/circular_progress_drawable" />

            <!-- App Logo in Center of Circular Ring -->
            <ImageView
                android:id="@+id/widget_app_logo_center"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="18dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="Selected App Logo" />

            <!-- Used / Earned Text at Bottom -->
            <TextView
                android:id="@+id/fravo_used_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/widget_circular_progress"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="4dp"
                android:text="Used 0m / 0m"
                android:textColor="@color/widget_text_secondary"
                android:textSize="9sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- PREMIUM USER CONTAINER: Horizontal Progress Bar with App Logo -->
        <LinearLayout
            android:id="@+id/widget_premium_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/widget_card_background"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/widget_app_logo_premium"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="App Logo" />

                <TextView
                    android:id="@+id/widget_app_name_premium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Instagram"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/fravo_premium_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45m left"
                    android:textColor="@color/widget_steps_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Horizontal Usage Bar (Green = Remaining) -->
            <ProgressBar
                android:id="@+id/widget_horizontal_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="75"
                android:progressDrawable="@drawable/horizontal_progress_drawable" />

            <TextView
                android:id="@+id/fravo_premium_used"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Used: 15m of 60m"
                android:textColor="@color/widget_text_secondary"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
