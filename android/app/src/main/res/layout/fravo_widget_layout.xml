<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/widget_puffy_bg"
    android:baselineAligned="false">

    <!-- Left: Pippy Mascot Stage with Streak Badge -->
    <RelativeLayout
        android:id="@+id/widget_stage"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.05"
        android:background="@drawable/widget_stage_bg"
        android:padding="6dp">

        <ImageView
            android:id="@+id/widget_pippy_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/widget_streak_chip"
            android:layout_centerHorizontal="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_pippy_mascot"
            android:contentDescription="Pippy Mascot" />

        <TextView
            android:id="@+id/widget_streak_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/widget_streak_chip_bg"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="🔥 12d"
            android:textColor="#EA580C"
            android:textSize="10sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <View
        android:layout_width="10dp"
        android:layout_height="match_parent" />

    <!-- Right: Personality Speech Bubble & Live Stats -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.2"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Speech Bubble with Live Companion Dialogue -->
        <TextView
            android:id="@+id/widget_speech_bubble"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_speech_bubble_bg"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:text="🧘 Inhale calm. A gentle stroll will awaken Instagram!"
            android:textColor="#1E293B"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:maxLines="3"
            android:ellipsize="end" />

        <View
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Stats Pill Row -->
        <LinearLayout
            android:id="@+id/widget_stat_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_stat_pill_bg"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            android:orientation="horizontal">

            <!-- Remaining Time -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_time_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REMAINING"
                    android:textColor="#64748B"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_time_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45m left"
                    android:textColor="#059669"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Steps Walked -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_steps_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEPS"
                    android:textColor="#64748B"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_steps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7,420 / 10k"
                    android:textColor="#1E293B"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
